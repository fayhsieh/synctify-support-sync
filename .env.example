# 複製本檔為 .env 並填入實際值。.env 不會進版控。
#
# 這裡只給「本機腳本」用。正式運作時的憑證存在 n8n 的 credential 管理裡，
# workflow JSON 只放引用（CLAUDE.md）。
#
# 標示說明：
#   [必填]  現在就會被讀取，沒填會壞
#   [選填]  不填不影響功能，填了本機除錯比較方便
#   [待用]  之後的階段才需要，現在留空即可


# ── WordPress ────────────────────────────────────
# [必填] scripts/verify_endpoints.py 與各種本機查證腳本都會讀
WP_BASE_URL=https://support.synctify.io
WP_USERNAME=
# 使用者 → 個人資料 → Application Passwords 產生（格式：xxxx xxxx xxxx xxxx xxxx xxxx）
WP_APP_PASSWORD=


# ── n8n webhook path ─────────────────────────────
# [必填] 給 `python scripts/build_n8n_code_node.py --local` 用。
# 填了之後產出的 n8n/local/ 匯入就不必手填 Path；進版控的產出永遠是佔位字串。
#   echo "N8N_WEBHOOK_PATH=synctify-sync-$(openssl rand -hex 16)" >> .env
#   echo "N8N_PUBLISH_WEBHOOK_PATH=synctify-published-$(openssl rand -hex 16)" >> .env
N8N_WEBHOOK_PATH=
N8N_PUBLISH_WEBHOOK_PATH=

# webhook 的 Header Auth 密鑰**不放這裡**——沒有任何程式會讀它。
# 它的正本在兩個地方，改的時候兩邊都要換：
#   1. n8n 的 Header Auth 憑證（存進去之後 UI 讀不回來）
#   2. Notion 按鈕的 Send webhook → Add custom header
# 需要留一份自己看得到的備份時，用密碼管理器，不要用純文字檔。


# ── Notion ───────────────────────────────────────
# [選填] 目前沒有程式讀它。填了才能在本機直接抓 Notion 的原始 block JSON
# 餵給轉換器重現問題——沒有它只能靠渲染後的 markdown 手工重建測試資料。
NOTION_API_KEY=

# [參考] 實際值寫在 scripts/build_n8n_code_node.py 的 NOTION_DB_ID，這裡僅供對照。
# ⚠️ REST API（/v1/databases/{id}/query）要的是 **database** ID，
# 不是新版 API 的 collection／data source ID
# （3272f2ed-e27d-80f9-8e2d-000be0502aa8，丟進去會回 404 object_not_found）
NOTION_CONTENT_HUB_DB_ID=3272f2ed-e27d-807e-9fac-f2313dd2d0de

# [待用] 翻譯階段的術語表
NOTION_GLOSSARY_DB_ID=28d2f2ed-e27d-805b-90f3-000b73c8a2af


# ── 翻譯（Workflow 3，尚未開始）──────────────────
# [待用]
OPENAI_API_KEY=
OPENAI_MODEL=


# ── TranslatePress ───────────────────────────────
# [必填] scripts/verify_endpoints.py 會讀
TP_TARGET_LANGUAGE=zh_CN
