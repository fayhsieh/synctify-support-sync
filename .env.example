# 複製本檔為 .env 並填入實際值。.env 不會進版控。
# 正式運作時這些值應存在 n8n credential 中，此檔僅供本機測試腳本使用。

# ── WordPress ────────────────────────────────────
WP_BASE_URL=https://support.synctify.io
WP_USERNAME=
# 使用者 → 個人資料 → Application Passwords 產生（格式：xxxx xxxx xxxx xxxx xxxx xxxx）
WP_APP_PASSWORD=

# ── Notion ───────────────────────────────────────
NOTION_API_KEY=
# ⚠️ REST API（/v1/databases/{id}/query）要的是 **database** ID，
# 不是 Notion 新版 API 的 collection／data source ID
# （3272f2ed-e27d-80f9-8e2d-000be0502aa8，丟進去會回 404 object_not_found）
NOTION_CONTENT_HUB_DB_ID=3272f2ed-e27d-807e-9fac-f2313dd2d0de
NOTION_GLOSSARY_DB_ID=28d2f2ed-e27d-805b-90f3-000b73c8a2af

# ── OpenAI（翻譯）────────────────────────────────
OPENAI_API_KEY=
OPENAI_MODEL=

# ── n8n webhook ──────────────────────────────────
# Notion 按鈕呼叫 webhook 時帶的 header token，隨機字串即可
N8N_WEBHOOK_TOKEN=

# webhook 的 path。填了之後跑 `python scripts/build_n8n_code_node.py --local`
# 會另外產一份 n8n/local/（已 gitignore），匯入就不必再手填 Path。
# 進版控的產出永遠是佔位字串。
#   echo "N8N_WEBHOOK_PATH=synctify-sync-$(openssl rand -hex 16)" >> .env
#   echo "N8N_PUBLISH_WEBHOOK_PATH=synctify-published-$(openssl rand -hex 16)" >> .env
N8N_WEBHOOK_PATH=
N8N_PUBLISH_WEBHOOK_PATH=

# ── TranslatePress ───────────────────────────────
TP_TARGET_LANGUAGE=zh_CN
